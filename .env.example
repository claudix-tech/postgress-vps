# Copy to .env and change every password before first start.
POSTGRES_VERSION=18
CONTAINER_NAME=postgres
VOLUME_NAME=postgres_data

# Network: keep 127.0.0.1 unless the port is firewalled / needed remotely.
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

# Superuser (admin only, never use from applications)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser
POSTGRES_DB=postgres

# Application role + database, created on first init by initdb/01-create-app-db.sh
APP_DB_NAME=app
APP_DB_USER=app
APP_DB_PASSWORD=change-me-app

# Tuning
PG_SHARED_BUFFERS=256MB
PG_MAX_CONNECTIONS=100
PG_LOG_MIN_DURATION=1000

# Backups
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
